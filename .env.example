# Copy sang .env khi chay that. Khong commit file .env.
PORT=5001
VIEWPORT=1920x1080
MAX_TABS=8
PROFILE_DIR=./profile
# HEADLESS: true = chay ngam (khuyen nghi, on dinh khi khoa may/tat man hinh).
# false = hien cua so Chromium de nhin truc tiep.
HEADLESS=true
# NO_GPU: true = tat GPU (may khong co GPU hoac muon tiet kiem dien).
# false (mac dinh) = dung GPU neu co, giam tai CPU dang ke.
NO_GPU=false
# TOKEN tuy chon: chi can khi mo server ra ngoai LAN (qua Tailscale/tunnel).
# Client them ?token=... vao URL. Bo trong = tat (chi dung trong LAN tin cay).
TOKEN=
